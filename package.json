{
  "name": "samepage-redesigns",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -p 3001",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "quality:react": "react-doctor --no-score --no-telemetry --no-supply-chain --blocking warning -y",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check:source-size": "node scripts/check-source-size.mjs",
    "check:originals": "node scripts/check-originals.mjs",
    "build": "next build",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "start": "next start -p 3001"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260904.1",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.4",
    "jsdom": "^26.1.0",
    "react-doctor": "0.9.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vitest": "^3.2.7",
    "wrangler": "^4.129.0"
  }
}
